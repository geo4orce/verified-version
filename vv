#!/bin/sh

VV_VERSION=2.2.0
VV_TIMEOUT=${VV_TIMEOUT:-5}
VV_ESC=$(printf '\033')

VV_TIMEOUT_BIN=
if command -v timeout >/dev/null 2>&1; then
  VV_TIMEOUT_BIN=timeout
elif command -v gtimeout >/dev/null 2>&1; then
  VV_TIMEOUT_BIN=gtimeout
fi

vv_run() {
  if [ -n "$VV_TIMEOUT_BIN" ]; then
    "$VV_TIMEOUT_BIN" "$VV_TIMEOUT" "$@" </dev/null 2>&1
  else
    "$@" </dev/null 2>&1
  fi
}

vv_extract_generic() {
  _clean=$(printf '%s\n' "$1" | sed "s/${VV_ESC}\[[0-9;]*[A-Za-z]//g")
  _v=$(printf '%s\n' "$_clean" | grep -oE '[0-9]+(\.[0-9]+)+' | head -1)
  if [ -z "$_v" ]; then
    _v=$(printf '%s\n' "$_clean" | grep -oE '[0-9]+' | head -1)
  fi
  printf '%s' "$_v"
}

vv_probe_is_safe() {
  case $1 in
    nano|pico|smerge|subl|sw_vers) return 1 ;;
    *) return 0 ;;
  esac
}

vv_run_fallback() {
  _fallback_bin=$1
  _fallback_name=$2

  case $_fallback_name in
    go|terraform) vv_run "$_fallback_bin" version ;;
    kubectl) vv_run "$_fallback_bin" version --client ;;
    nano|pico) vv_run "$_fallback_bin" -version ;;
    sw_vers) vv_run "$_fallback_bin" -productVersion ;;
    *) vv_run "$_fallback_bin" --version ;;
  esac
}

vv_fallback_allows_nonzero() {
  case $1 in
    nano|pico) return 0 ;;
    *) return 1 ;;
  esac
}

vv_component() {
  _part=$1
  case $_part in
    ''|*[!0-9]*)
      printf '0'
      return
      ;;
  esac
  while [ "${_part#0}" != "$_part" ]; do
    _part=${_part#0}
  done
  printf '%s' "${_part:-0}"
}

vv_normalize() {
  _n=$1
  _n=${_n#[vV]}
  if [ -z "$_n" ]; then
    printf '0.0.0\n'
    return
  fi
  _a=${_n%%.*}
  _r=${_n#*.}; [ "$_r" = "$_n" ] && _r=
  _b=${_r%%.*}
  _r2=${_r#*.}; [ "$_r2" = "$_r" ] && _r2=
  _c=${_r2%%.*}
  _a=$(vv_component "$_a")
  _b=$(vv_component "$_b")
  _c=$(vv_component "$_c")
  printf '%s.%s.%s\n' "$_a" "$_b" "$_c"
}

vv_usage() {
  cat <<EOF
vv $VV_VERSION

Usage:
  vv <tool>               print the tool version as X.Y.Z
  vv --verified-version   print the vv version
  vv --version            print the vv version
  vv -h                   show help
EOF
}

vv_lookup() {
  _bin=$1

  if ! command -v "$_bin" >/dev/null 2>&1; then
    printf '0.0.0\n'
    return
  fi

  _name=${_bin##*/}
  _name=${_name##*\\}

  if vv_probe_is_safe "$_name"; then
    if _probe=$(vv_run "$_bin" --verified-version); then
      _probe_lines=$(printf '%s\n' "$_probe" | wc -l | tr -d ' ')
      if [ "$_probe_lines" -eq 1 ] && \
        printf '%s\n' "$_probe" | grep -qE \
          '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
        printf '%s\n' "$_probe"
        return
      fi
    fi
  fi

  _raw=$(vv_run_fallback "$_bin" "$_name")
  _rc=$?

  if [ "$_rc" -eq 124 ] || [ -z "$_raw" ]; then
    printf '0.0.0\n'
    return
  fi
  if [ "$_rc" -ne 0 ] && ! vv_fallback_allows_nonzero "$_name"; then
    printf '0.0.0\n'
    return
  fi

  _ver=$(vv_extract_generic "$_raw")
  vv_normalize "$_ver"
}

case ${1:-} in
  ''|-h|--help)
    vv_usage
    ;;
  --verified-version|--version)
    printf '%s\n' "$VV_VERSION"
    ;;
  -*)
    printf 'unknown option: %s\n' "$1" >&2
    exit 2
    ;;
  *)
    vv_lookup "$1"
    ;;
esac

exit 0
